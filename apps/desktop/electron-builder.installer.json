{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "app.autoinstall-ui.installer",
  "productName": "Autoinstall USB Creator Setup",
  "copyright": "Copyright © 2026",
  "directories": {
    "output": "release",
    "buildResources": "installer-resources"
  },
  "extraMetadata": {
    "name": "autoinstall-ui-installer",
    "main": "out/installer/main/index.js",
    "productName": "Autoinstall USB Creator Setup"
  },
  "files": ["out/installer/**/*", "!**/*.map", "package.json"],
  "extraResources": [
    { "from": "installer-resources/payload.7z", "to": "payload.7z" },
    { "from": "installer-resources/7za.exe", "to": "7za.exe" },
    { "from": "installer-resources/icon.ico", "to": "icon.ico" },
    { "from": "installer-resources/payload-meta.json", "to": "payload-meta.json" }
  ],
  "asar": true,
  "npmRebuild": false,
  "compression": "maximum",
  "win": {
    "target": [{ "target": "portable", "arch": ["x64"] }],
    "icon": "installer-resources/icon.ico",
    "requestedExecutionLevel": "asInvoker"
  },
  "portable": {
    "artifactName": "${productName}-${version}.${ext}",
    "requestExecutionLevel": "user",
    "unicode": true,
    "useZip": false
  }
}
