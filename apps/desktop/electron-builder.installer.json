{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "jp.unlit-cube.seedstick.installer",
  "productName": "Seedstick Setup",
  "copyright": "Copyright © 2026 UnlitCube",
  "publish": null,
  "directories": {
    "output": "release",
    "buildResources": "installer-resources"
  },
  "extraMetadata": {
    "name": "seedstick-installer",
    "main": "out/installer/main/index.js",
    "productName": "Seedstick Setup"
  },
  "files": [
    "out/installer/**/*",
    "!**/*.map",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "installer-resources/payload.7z",
      "to": "payload.7z"
    },
    {
      "from": "installer-resources/7za.exe",
      "to": "7za.exe"
    },
    {
      "from": "installer-resources/icon.ico",
      "to": "icon.ico"
    },
    {
      "from": "installer-resources/payload-meta.json",
      "to": "payload-meta.json"
    },
    {
      "from": "../../LICENSE",
      "to": "LICENSE.txt"
    },
    {
      "from": "build/THIRD_PARTY_NOTICES.txt",
      "to": "THIRD_PARTY_NOTICES.txt"
    }
  ],
  "asar": true,
  "npmRebuild": false,
  "compression": "maximum",
  "win": {
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      }
    ],
    "icon": "installer-resources/icon.ico",
    "requestedExecutionLevel": "asInvoker"
  },
  "portable": {
    "artifactName": "Seedstick-${version}-win-x64-Setup.${ext}",
    "requestExecutionLevel": "user",
    "unicode": true,
    "useZip": false
  },
  "afterPack": "./scripts/after-pack.cjs"
}
