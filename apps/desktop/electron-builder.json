{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "app.autoinstall-ui.desktop",
  "productName": "Autoinstall USB Creator",
  "copyright": "Copyright © 2026",
  "publish": null,
  "directories": {
    "output": "release",
    "buildResources": "build"
  },
  "files": ["out/**/*", "!out/installer/**/*", "package.json"],
  "extraResources": [{ "from": "../../samples", "to": "samples", "filter": ["**/*"] }],
  "asarUnpack": [],
  "npmRebuild": false,
  "afterPack": "./scripts/after-pack.cjs",
  "win": {
    "target": [{ "target": "portable", "arch": ["x64"] }],
    "artifactName": "AutoinstallUSBCreator-${version}-win-${arch}-portable.${ext}",
    "requestedExecutionLevel": "asInvoker"
  },
  "portable": {
    "artifactName": "AutoinstallUSBCreator-${version}-win-${arch}-portable.${ext}"
  },
  "mac": {
    "target": [
      { "target": "dmg", "arch": ["x64", "arm64"] },
      { "target": "zip", "arch": ["x64", "arm64"] }
    ],
    "category": "public.app-category.utilities",
    "artifactName": "AutoinstallUSBCreator-${version}-mac-${arch}.${ext}",
    "identity": null,
    "hardenedRuntime": false,
    "gatekeeperAssess": false,
    "notarize": false
  },
  "dmg": {
    "artifactName": "AutoinstallUSBCreator-${version}-mac-${arch}.${ext}",
    "window": { "width": 540, "height": 380 },
    "contents": [
      { "x": 150, "y": 205, "type": "file" },
      { "x": 390, "y": 205, "type": "link", "path": "/Applications" }
    ]
  },
  "linux": {
    "target": [
      { "target": "AppImage", "arch": ["x64"] },
      { "target": "deb", "arch": ["x64"] }
    ],
    "category": "Utility",
    "artifactName": "AutoinstallUSBCreator-${version}-linux-${arch}.${ext}",
    "desktop": {
      "entry": {
        "Name": "Autoinstall USB Creator",
        "Comment": "Build an unattended Ubuntu Server install USB"
      }
    }
  },
  "deb": {
    "depends": ["libgtk-3-0", "libnotify4", "libnss3", "libxss1", "libxtst6", "xdg-utils", "libatspi2.0-0", "libsecret-1-0", "policykit-1"]
  }
}
