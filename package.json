{
  "name": "seedstick",
  "private": true,
  "version": "0.1.0",
  "description": "Experimental, unofficial GUI for building unattended-install USB drives for Ubuntu Server (Electron, Windows/macOS/Linux)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev -w @autoinstall/desktop",
    "build": "npm run build -w @autoinstall/desktop",
    "typecheck": "tsc -p packages/shared/tsconfig.json && tsc -p packages/media/tsconfig.json && tsc -p apps/desktop/tsconfig.node.json && tsc -p apps/desktop/tsconfig.json && tsc -p apps/desktop/tsconfig.installer.json && tsc -p apps/desktop/tsconfig.installer-renderer.json && tsc -p scripts/tsconfig.json",
    "test:unit": "vitest run",
    "smoke": "tsx scripts/smoke-media.mts",
    "test": "npm run typecheck && npm run test:unit && npm run smoke",
    "dist:win": "npm run dist:win -w @autoinstall/desktop",
    "dist:mac": "npm run dist:mac -w @autoinstall/desktop",
    "dist:linux": "npm run dist:linux -w @autoinstall/desktop",
    "dist:installer": "npm run dist:installer -w @autoinstall/desktop",
    "e2e": "tsx scripts/e2e-matrix.mts",
    "e2e:image": "tsx scripts/e2e-image-file.mts",
    "e2e:raid-bond": "tsx scripts/e2e-raid-bond.mts",
    "e2e:esp-mirror": "tsx scripts/e2e-esp-mirror.mts",
    "e2e:uninstall-script": "tsx scripts/e2e-uninstall-script.mts",
    "e2e:usb": "tsx scripts/e2e-write-usb.mts",
    "e2e:vm": "tsx scripts/e2e-vm.mts",
    "e2e:vm:raid": "tsx scripts/e2e-vm.mts --raid",
    "e2e:vm:mirror": "tsx scripts/e2e-vm.mts --mirror",
    "e2e:vm:ip": "tsx scripts/e2e-vm.mts --ip",
    "e2e:verify-usb": "tsx scripts/e2e-verify-usb.mts",
    "e2e:usb-worker": "tsx scripts/e2e-worker-usb.mts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jsdom": "^29.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0",
    "ws": "^8.21.3"
  },
  "license": "MIT",
  "author": "UnlitCube",
  "homepage": "https://unlitcube.github.io/seedstick/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UnlitCube/seedstick.git"
  },
  "bugs": {
    "url": "https://github.com/UnlitCube/seedstick/issues"
  }
}
